# ===================================
# RNV Manager - Environment Variables
# ===================================
# Producción: /etc/rnv-manager/rnv.env
# Local:      cp env.template .env

# ── Base de Datos ─────────────────────────────────────────────────────────────
DB_USER=rnvadmin
DB_PASSWORD=rnv_secure_password_2025
DB_NAME=rnv_manager
DATABASE_URL=postgresql://rnvadmin:rnv_secure_password_2025@db:5432/rnv_manager?sslmode=disable

# ── Go API ────────────────────────────────────────────────────────────────────
# JWT (≥32 chars). En prod legacy: SESSION_SECRET se usa si JWT_SECRET falta
JWT_SECRET=rnv-super-secret-jwt-key-change-in-production-2025
APP_URL=https://rnv.renace.tech
GIN_MODE=release

# ── Auth ──────────────────────────────────────────────────────────────────────
MASTER_PASSWORD=JustWork2027@
NOTIFICATION_EMAIL=expertostird@gmail.com

# ── Hostinger API ─────────────────────────────────────────────────────────────
HOSTINGER_API_TOKEN=

# ── Odoo ──────────────────────────────────────────────────────────────────────
