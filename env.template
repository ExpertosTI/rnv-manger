# ===================================
# RNV Manager - Environment Variables
# ===================================
# Producción: /etc/rnv-manager/rnv.env
# Local:      cp env.template .env

# ── Base de Datos ─────────────────────────────────────────────────────────────
DB_USER=rnvadmin
DB_PASSWORD=rnv_secure_password_2025
DB_NAME=rnv_manager
DATABASE_URL=postgresql://rnvadmin:rnv_secure_password_2025@db:5432/rnv_manager?sslmode=disable

# ── Go API ────────────────────────────────────────────────────────────────────
# JWT (≥32 chars). En prod legacy: SESSION_SECRET se usa si JWT_SECRET falta
JWT_SECRET=rnv-super-secret-jwt-key-change-in-production-2025
APP_URL=https://rnv.renace.tech
GIN_MODE=release
# Interfaz de escucha. Vacío = todas las interfaces (:PORT). Para dejar la API
# solo en localhost detrás de un proxy: HOST=127.0.0.1. BIND_ADDR gana si ambos están.
# Dentro de Docker déjalo vacío: 127.0.0.1 es el loopback del contenedor.
HOST=
# BIND_ADDR=
PORT=8080

# Addons en el servidor Next. Vacío = la sección solo existe en la app de escritorio.
# RNV_ADDONS_ROOTS: lista blanca separada por : o , (sin esos caracteres dentro de la ruta).
# NEXT_PUBLIC_ADDONS_DEFAULT_ROOT se lee al construir la UI.
# RNV_ADDONS_LOCAL=
RNV_ADDONS_ROOTS=
# NEXT_PUBLIC_ADDONS_DEFAULT_ROOT=

# ── Auth ──────────────────────────────────────────────────────────────────────
MASTER_PASSWORD=JustWork2027@
NOTIFICATION_EMAIL=expertostird@gmail.com

# ── Hostinger API ─────────────────────────────────────────────────────────────
HOSTINGER_API_TOKEN=

# ── Odoo ──────────────────────────────────────────────────────────────────────
ODOO_URL=
ODOO_DB=
ODOO_USERNAME=
ODOO_API_KEY=

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@renace.tech
SMTP_PASS=
SMTP_FROM=info@renace.tech

# ── AI Assistant (Gemini) ─────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── WhatsApp (Evolution API — SOLO línea empresa Renace) ──────────────────────
# Instancia evoapi: renace · DEBE estar conectada al WhatsApp de Renace (849).
# NUNCA conectar aquí el WhatsApp de un cliente (privacidad / bloqueos).
EVOLUTION_API_URL=https://evoapi.renace.tech
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=renace
# Número que DEBE estar escaneado en la instancia (owner). Si no coincide, RNV no envía nada.
WHATSAPP_OWNER_NUMBER=18494577463
# Destinatarios admin OTP/login (coma, sin +). Cobros a clientes = teléfono del cliente vía esta misma línea empresa.
WHATSAPP_NOTIFY_NUMBERS=18494577463
WHATSAPP_SENDER_LABEL=Renace
