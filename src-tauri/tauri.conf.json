{
  "productName": "RNV Manager",
  "version": "1.0.0",
  "identifier": "tech.renace.rnv-manager",
  "build": {
    "frontendDist": "../tauri-dist",
    "devUrl": "https://rnv.renace.tech"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "RNV Manager",
        "url": "https://rnv.renace.tech",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "acceptFirstMouse": true,
        "visible": false
      },
      {
        "label": "chat",
        "title": "RNV AI Chat",
        "url": "https://rnv.renace.tech/widget",
        "width": 440,
        "height": 660,
        "center": true,
        "resizable": true,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "skipTaskbar": true
      },
      {
        "label": "whiteboard",
        "title": "RNV Manager — Pizarra y Arquitectura",
        "url": "https://rnv.renace.tech/whiteboard-app/index.html",
        "width": 1280,
        "height": 850,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "decorations": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null,
      "minimumSystemVersion": "10.15"
    },
    "resources": []
  }
}
